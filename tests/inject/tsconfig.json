{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2019",
        "module": "ES2015",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "chrome",
            "vitest/globals"
        ],
        "allowJs": true,
        "downlevelIteration": true,
        "esModuleInterop": true,
        "jsx": "react",
        "jsxFactory": "m",
        "moduleResolution": "Node",
        "noEmit": true,
        "noImplicitAny": true,
        "removeComments": false,
        "sourceMap": true,
        "inlineSources": true,
        "noEmitOnError": true,
        "strictPropertyInitialization": false,
        "skipLibCheck": true,
        "baseUrl": "../../src",
        "paths": {
            "@plus/*": ["stubs/*"]
        },
        "ignoreDeprecations": "6.0",
    },
    "exclude": [
        "./vitest.config.mjs",
        "./support/echo-server.js",
        "./support/global-setup.js"
    ]
}
